configuration{
    font: "JetBrainsMono Nerd Font 10";
    modi: "drun,window,combi,drun";
    icon-theme: "Oranchelo";
    show-icons: true;
    terminal: "kitty";
    drun-display-format: "{icon} {name}";
    location: 0;
    disable-history: false;
    hide-scrollbar: true;
    display-combi: " ";
    display-run: " ";
    display-window: " ";
    display-drun: " ";
    sidebar-mode: true;

    /* Your custom Vim bindings (already present) */
    kb-move-char-back: "Left,Control+b,Control+h";
    kb-move-char-forward: "Right,Control+f,Control+l";
    kb-row-up: "Up,Control+p,Shift+Tab,Control+k";
    kb-row-down: "Down,Control+n,Control+j";
    ml-row-left: "ScrollLeft,Control+h";
    ml-row-right: "ScrollRight,Control+l";

    /* --- Remove conflicting default keys --- */
    /* Remove Control+h from "delete previous char" */
    kb-remove-char-back: "BackSpace,Shift+BackSpace";
    
    /* Remove Control+l from "start completion" */
    kb-mode-complete: "";
    
    /* Remove Control+k from "delete to end of line" */
    kb-remove-to-eol: "";
    
    /* Remove Control+j from "accept entry" */
    kb-accept-entry: "Control+m,Return,KP_Enter";
}

// @theme "windows11-grid-dark"
@theme "themes/catppuccin-frappe"

